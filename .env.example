# Reed API - Environment Configuration
# Copy this file to .env and customize as needed

# ============================================================================
# LLM Configuration
# ============================================================================

# Provider: "groq" (cloud, default) or "ollama" (local)
LLM_PROVIDER=groq

# --- Ollama (local) ---

# Ollama API endpoint
OLLAMA_URL=http://localhost:11434/api/generate

# Ollama model to use for explanations
OLLAMA_MODEL=gpt-oss:20b

# Request timeout in seconds
OLLAMA_TIMEOUT=30.0

# --- Groq (cloud — fast inference) ---

# Groq API key (get one at https://console.groq.com/keys)
GROQ_API_KEY=

# Groq API base URL (no trailing slash)
GROQ_API_URL=https://api.groq.com/openai/v1

# Groq model to use (see https://console.groq.com/docs/models)
GROQ_MODEL=llama-3.3-70b-versatile

# Request timeout in seconds
GROQ_TIMEOUT=30.0

# ============================================================================
# Storage Configuration
# ============================================================================

# Storage backend: "neo4j" (default, graph-based memory) or "sqlite"
STORAGE_BACKEND=neo4j

# Base directory for data files
REED_DATA_DIR=data

# SQLite database path for memories (used when STORAGE_BACKEND=sqlite)
MEMORY_DB_PATH=data/memories.db

# Pattern index JSON file path
PATTERN_INDEX_PATH=data/pattern_index.json

# Enable FAISS ANN index for numeric similarity (SQLite mode only)
ENABLE_ANN_INDEX=true

# Enable text embeddings (requires sentence-transformers)
ENABLE_EMBEDDINGS=false

# Embedding model name
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Store FAISS index on disk (vs in-memory)
FAISS_INDEX_ON_DISK=false

# ============================================================================
# Neo4j Configuration (required when STORAGE_BACKEND=neo4j)
# ============================================================================

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j
NEO4J_CONNECT_TIMEOUT_S=5.0
NEO4J_MAX_POOL_SIZE=50
NEO4J_TX_RETRY_S=5.0
NEO4J_GRAPH_OUTBOX_PATH=data/neo4j_graph_outbox.jsonl

# ============================================================================
# SINDIT Digital-Twin Integration (optional)
# ============================================================================

# Enable SINDIT context enrichment
SINDIT_ENABLED=false

# SINDIT REST API URL
SINDIT_API_URL=http://localhost:9017

# SINDIT request timeout in seconds
SINDIT_TIMEOUT_S=5.0

# ============================================================================
# Significance Thresholds
# ============================================================================

# Minimum score to store a memory (0.0 - 1.0)
SIG_STORE_THRESHOLD=0.3

# Minimum score to trigger an alert (0.0 - 1.0)
SIG_ALERT_THRESHOLD=0.6

# Minimum score for critical alert (0.0 - 1.0)
SIG_CRITICAL_THRESHOLD=0.85

# ============================================================================
# Significance Rule Weights (should sum to ~1.0)
# ============================================================================

# Weight for external/classical model signals
SIG_WEIGHT_CLASSICAL=0.4

# Weight for pattern-based rules
SIG_WEIGHT_PATTERN=0.25

# Weight for statistical anomaly detection
SIG_WEIGHT_ANOMALY=0.2

# Weight for historical priors (learned from feedback)
SIG_WEIGHT_PRIOR=0.15

# Evidence volume at which a learned prior reaches half effect (n/(n+k)).
# Default 20 assumes plentiful window-level feedback; use ~5 when feedback is
# one operator verdict per work-order episode.
SIG_PRIOR_DAMPING_K=20.0

# Sub-neutral prior damping (ISS-13): allow sustained operator dismissals to
# damp scores below neutral. Guarded: confirmations on any pattern win over
# dismissals, damping needs SIG_PRIOR_SUBNEUTRAL_MIN_EVIDENCE dismissals, the
# factor never drops below SIG_PRIOR_FACTOR_FLOOR, and events whose base
# evidence reaches the critical band are immune.
# See docs/FEEDBACK_MECHANISM_PROPOSAL_2026-07-07.md.
SIG_PRIOR_ALLOW_SUBNEUTRAL=0
SIG_PRIOR_FACTOR_FLOOR=0.85
SIG_PRIOR_SUBNEUTRAL_MIN_EVIDENCE=3.0

# ============================================================================
# Pattern Detection Thresholds
# ============================================================================

# Force ratio threshold for chatter detection
CHATTER_RATIO_THRESHOLD=5.0

# Anomaly score threshold for OnlineAgent.
# NOTE: if MEMORY_CALIBRATE_MODEL_SCORE=1 the model score is a session-relative
# percentile in [0,1] — set this to ~0.95 (alert on the top 5% of the session)
# instead of the raw-score default 0.7.
ANOMALY_SCORE_THRESHOLD=0.7

# Session score calibration (plan 1.2). When enabled, the raw one-class model
# score is replaced per session by a rolling percentile before scoring, fixing
# cross-session score shift (a model trained elsewhere over-alerting on a new
# session). OFF by default: needs ANOMALY_SCORE_THRESHOLD retuned (above) and a
# blind warm-up window at session start. See docs/FEEDBACK_STATE_2026-07-08.md.
MEMORY_CALIBRATE_MODEL_SCORE=0
MEMORY_CALIBRATE_WARMUP=30
MEMORY_CALIBRATE_WINDOW=480

# ============================================================================
# Memory System Behavior
# ============================================================================

# Generate LLM explanations for significant events.
# Requires a running LLM service (Ollama or Groq).
# When off (default), heuristic fallbacks are used instead — no timeouts.
GENERATE_EXPLANATIONS=false

# Dispatch WebSocket alerts for significant events
DISPATCH_ALERTS=true

# Number of similar memories to retrieve
TOP_K_SIMILAR=5
